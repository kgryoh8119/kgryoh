    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
